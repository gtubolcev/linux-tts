+    {U"компьютер", U"компьютэр"}, {U"менеджер", U"мэнэджэр"}, {U"менеджмент", U"мэнэджмэнт"}, {U"бизнес", U"бизнэс"},
+    {U"тенденци", U"тэндэнци"}, {U"теннис", U"тэннис"}, {U"темп", U"тэмп"}, {U"стенд", U"стэнд"}, {U"свитер", U"свитэр"},
+    {U"детектив", U"дэтэктив"}, {U"антенн", U"антэнн"}, {U"лидер", U"лидэр"}, {U"рейтинг", U"рэйтинг"}, {U"бренд", U"брэнд"},
+    {U"тренд", U"трэнд"}, {U"сленг", U"слэнг"}, {U"гаджет", U"гаджэт"}, {U"хакер", U"хакэр"}, {U"тостер", U"тостэр"},
