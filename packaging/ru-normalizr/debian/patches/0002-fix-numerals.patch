     return "gent"
 
 
+def _is_person_head(parse: MorphParse | None) -> bool:
+    """Одушевлённое нарицательное в именительном: «девочка», «парень»."""
+    if parse is None or parse.tag.POS != "NOUN" or parse.tag.case != "nomn":
+        return False
+    tag = parse.tag
+    return "anim" in tag and not ({"Name", "Surn", "Patr"} & tag.grammemes)
+
+
+def _rule_age_attribute(ctx: NumeralContext) -> str | None:
+    """Возраст как определение лица — родительный признака.
+
+    «девочка 12 лет» → «девочка двенадцати лет», «девушка, лет 18» →
+    «лет восемнадцати», «парень лет 25 на вид». Глагол сразу за «лет»
+    («Девочка 5 лет играла») и «назад» делают число сроком, а сказуемое
+    слева («Ему было лет 18») — обычным количеством; там правило молчит.
+    """
+    if ctx.word(-1) == "лет":
+        if ctx.raw(-1) != "лет":
+            return None
+        head_offset = -3 if ctx.raw(-2) == "," else -2
+        if _is_person_head(ctx.parse(head_offset)):
+            return "gent"
+        if ctx.word(1) == "на" and ctx.word(2) == "вид":
+            return "gent"
+        return None
+    if ctx.raw(1) != "лет" or not ctx.raw(-1).isalpha():
+        return None
+    if not _is_person_head(ctx.parse(-1)):
+        return None
+    after = ctx.parse(2)
+    if after is not None and (
+        after.tag.POS in {"VERB", "INFN", "GRND"}
+        or ctx.word(2) in {"назад", "спустя", "не", "уже", "ещё", "подряд"}
+    ):
+        return None
+    return "gent"
+
+
