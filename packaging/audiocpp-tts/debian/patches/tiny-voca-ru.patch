+    {U"диспансер", U"диспансэр"}, {U"бутерброд", U"бутэрброд"}, {U"интервал", U"интэрвал"}, {U"интерфейс", U"интэрфэйс"},
+    {U"тезис", U"тэзис"}, {U"пастел", U"пастэл"}, {U"модерн", U"модэрн"}, {U"демпинг", U"дэмпинг"},
+    {U"бестселлер", U"бэстсэллэр"}, {U"тент", U"тэнт"}, {U"тестировани", U"тэстировани"}, {U"тестировщик", U"тэстировщик"},
+    // г -> в, чн -> шн
+    {U"сегодн", U"севодн"}, {U"яичниц", U"яишниц"}, {U"скворечник", U"скворешник"},
+};
