+def _one_group_is_genitive(site: _NumberSite, alias: str) -> bool:
+    """Существительное в родительном единственного при числе на 1 (кроме 11).
+
+    Счётная форма при таком числе — падеж самого числа: «двадцать один дом».
+    Родительный единственного при именительном числе счётной формой быть не
+    может, и при существительном слева вся группа стоит в родительном:
+    «представители 21 страны» → «представители двадцати одной страны».
+    """
+    if noun_number_form(site.value) != "one" or site.case == "gent":
+        return False
+    if not word_is_known(alias):
+        return False
+    parses = parse_word(alias)
+    if any(
+        "NOUN" in p.tag and "sing" in p.tag and p.tag.case in {"nomn", "accs"} for p in parses
+    ):
+        return False
+    if not any("NOUN" in p.tag and p.tag.case == "gent" and "sing" in p.tag for p in parses):
+        return False
+    if any(p.normal_form in _SEQUENCE_NOUN_LEMMAS for p in parses if "NOUN" in p.tag):
+        return False
+    return _has_noun_head_on_the_left(site)
