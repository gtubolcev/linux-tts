#!/usr/bin/make -f
# The archives that CMake would fetch are in mirror/ of the orig tarball
# (see packaging/onnxruntime-tts/make-source.sh); CMake takes them from there.
# LTO over the statically linked dependencies takes hours and much memory
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
# false positives of GCC 13-15 in the vendored code, made errors by -Werror
export DEB_CFLAGS_MAINT_APPEND = -Wno-maybe-uninitialized
export DEB_CXXFLAGS_MAINT_APPEND = -Wno-maybe-uninitialized -Wno-error=maybe-uninitialized
# private directories, apart from the distribution's libonnxruntime
PRIV = lib/$(DEB_HOST_MULTIARCH)/linux-tts
# and apart from its python3-onnxruntime
PYPRIV = usr/lib/python3/linux-tts

%:
	dh $@ --buildsystem=cmake --sourcedirectory=cmake

# debhelper sets FETCHCONTENT_FULLY_DISCONNECTED=ON, which skips unpacking
# the local archives too; the URLs are local files, nothing is downloaded
override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_INSTALL_LIBDIR=$(PRIV) \
	  -DCMAKE_INSTALL_INCLUDEDIR=include/linux-tts \
	  -DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
	  -Donnxruntime_BUILD_SHARED_LIB=ON \
	  -Donnxruntime_BUILD_UNIT_TESTS=OFF \
	  -Donnxruntime_BUILD_BENCHMARKS=OFF \
	  -Donnxruntime_ENABLE_PYTHON=ON \
	  -Donnxruntime_USE_XNNPACK=OFF \
	  -DPython_EXECUTABLE=/usr/bin/python3

override_dh_auto_test:

# CMake does not install the Python module; the build assembles the package
# directory onnxruntime/ next to the libraries (as for setup.py)
override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/tmp/$(PYPRIV)
	# without the wheel's copy of the C library (the module has ORT linked in)
	tar -C obj-$(DEB_HOST_GNU_TYPE) --exclude=__pycache__ \
	  --exclude='onnxruntime/capi/libonnxruntime.so*' -cf - onnxruntime \
	  | tar -C debian/tmp/$(PYPRIV) -xf -
	# written by setup.py; without it every import warns
	printf 'package_name = "onnxruntime"\n__version__ = "%s"\n' \
	  "$$(cat VERSION_NUMBER)" > debian/tmp/$(PYPRIV)/onnxruntime/capi/build_and_package_info.py
	# the extension with the ABI tag of the build's Python, from which
	# dh_python3 takes the version range (below it renames nothing)
	cd debian/tmp/$(PYPRIV)/onnxruntime/capi && mv onnxruntime_pybind11_state.so \
	  onnxruntime_pybind11_state$$(python3 -c 'import sysconfig; print(sysconfig.get_config_var("EXT_SUFFIX"))')
	# the .so files of the package are not executables
	find debian/tmp/$(PYPRIV) -name '*.so' -exec chmod 644 {} +

# only this package has Python files; a plain dh_python3 would rename them
override_dh_python3:
	# no ABI tag on libonnxruntime_providers_shared.so: ORT loads it by name
	dh_python3 -ppython3-onnxruntime-tts --no-ext-rename /$(PYPRIV)
	dh_numpy3 -ppython3-onnxruntime-tts

# "Too many DIEs" for libonnxruntime.so: dwz gives up and fails the build
override_dh_dwz:
