+++ b/src/community_models/tiny_voca_ru/g2p.cpp
@@ -0,0 +1,842 @@
+#include "g2p.h"
+
+#include "dizione/pyre.h"
+
+#include <map>
+#include <optional>
+#include <set>
+#include <utility>
+
+namespace engine::models::tiny_voca_ru {
+namespace {
+
+using dizione::Str;
+using dizione::StrView;
+namespace py = dizione::py;
+namespace pyre = dizione::pyre;
+
+// ---------------------------------------------------------------- symbols.py
+
+const std::vector<std::string> kSpecials = {"<pad>", "<bos>", "<eos>", "<sp>", "<unk>"};
+const std::vector<std::string> kPunctuation = {",", ".", "?", "!", ";", ":", "\"", "'", "(", ")", "—", "…"};
+const std::vector<std::string> kConsonants = {
+    "p", "pʲ", "b", "bʲ", "t", "tʲ", "d", "dʲ", "k", "kʲ", "ɡ", "ɡʲ",     // stops, hard and soft
+    "f", "fʲ", "v", "vʲ", "s", "sʲ", "z", "zʲ",                           // fricatives
+    "ʂ", "ʐ", "ɕ", "x", "xʲ",                                             // ш ж (always hard), щ, х
+    "ts", "tɕ",                                                           // ц (always hard), ч (always soft)
+    "m", "mʲ", "n", "nʲ", "l", "lʲ", "r", "rʲ", "j",                      // sonorants
+};
+// Full vowels, and reduced ɐ (first pretonic, word-initial) and ə (other unstressed а/о).
+const std::vector<std::string> kVowels = {"a", "o", "e", "i", "u", "ɨ", "ɐ", "ə"};
+
+const std::string kBos = "<bos>";
+const std::string kEos = "<eos>";
+const std::string kSp = "<sp>";
+const std::string kUnk = "<unk>";
+
+using Set = std::set<std::string>;
+
+const Set & vowel_set() {
+    static const Set value(kVowels.begin(), kVowels.end());
+    return value;
+}
+
+const Set & phone_set() {
+    static const Set value = [] {
+        Set out(kConsonants.begin(), kConsonants.end());
+        out.insert(kVowels.begin(), kVowels.end());
+        return out;
+    }();
+    return value;
+}
+
+bool is_vowel(const std::string & phone) { return vowel_set().count(phone) != 0; }
+
+// Paired hard/soft consonants (ж ш ц are always hard; ч щ й are always soft).
+const std::map<std::string, std::string> & soft() {
+    static const std::map<std::string, std::string> value = [] {
+        std::map<std::string, std::string> out;
+        for (const char * hard : {"p", "b", "t", "d", "k", "ɡ", "f", "v", "s", "z", "x", "m", "n", "l", "r"}) {
+            out.emplace(hard, std::string(hard) + "ʲ");
+        }
+        return out;
+    }();
+    return value;
+}
+
+const Set kVoiceless = {"p", "pʲ", "t", "tʲ", "k", "kʲ", "f", "fʲ", "s", "sʲ", "ʂ", "ɕ", "x", "xʲ", "ts", "tɕ"};
+// х, ц, ч, щ have no voiced partner in the inventory and stay voiceless.
+const std::map<std::string, std::string> kVoicedPartner = {
+    {"p", "b"}, {"pʲ", "bʲ"}, {"t", "d"}, {"tʲ", "dʲ"}, {"k", "ɡ"}, {"kʲ", "ɡʲ"},
+    {"f", "v"}, {"fʲ", "vʲ"}, {"s", "z"}, {"sʲ", "zʲ"}, {"ʂ", "ʐ"},
+};
+
+const std::map<std::string, std::string> & voiceless_partner() {
+    static const std::map<std::string, std::string> value = [] {
+        std::map<std::string, std::string> out;
+        for (const auto & [voiceless, voiced] : kVoicedPartner) {
+            out.emplace(voiced, voiceless);
+        }
+        return out;
+    }();
+    return value;
+}
+
+const Set & obstruents() {
+    static const Set value = [] {
+        Set out = kVoiceless;
+        for (const auto & entry : voiceless_partner()) {
+            out.insert(entry.first);
+        }
+        return out;
+    }();
+    return value;
+}
