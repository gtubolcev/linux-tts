+def _rule_negated_existence(ctx: NumeralContext) -> str | None:
+    """Отрицание наличия ставит количество в родительный.
+
+    «У него нет 5 рублей» → «нет пяти рублей», «не хватает 2 голосов» →
+    «не хватает двух голосов». Справа обязано стоять слово в родительном:
+    «Нет, 5 рублей он вернул» запятой отделяет ответ, и «нет» там не управляет.
+    """
+    left = ctx.word(-1)
+    if not left or not ctx.raw(-1).isalpha():
+        return None
+    if left not in NEGATED_GENITIVE_PREDICATIVES:
+        if ctx.word(-2) != "не" or not ctx.raw(-2).isalpha():
+            return None
+        if not any(
+            p.normal_form in NEGATED_GENITIVE_VERB_LEMMAS
+            for p in top_scoring_verb_parses(parse_word(left))
+        ):
+            return None
+    right = ctx.word(1)
+    if not right:
+        return None
+    if not any(
+        p.tag.POS in {"NOUN", "ADJF", "PRTF"} and p.tag.case == "gent"
+        for p in parse_word(right)
+    ):
+        return None
+    return "gent"
+
