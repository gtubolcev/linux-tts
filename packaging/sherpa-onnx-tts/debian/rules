#!/usr/bin/make -f
# The dependencies that CMake would fetch are in the orig tarball at the top
# (see packaging/sherpa-onnx/make-source.sh); CMake takes them from there.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
LIBDIR = usr/lib/$(DEB_HOST_MULTIARCH)
# built against the private onnxruntime of libonnxruntime-tts (newer than
# the distribution's, for the Vulkan plugin EP); found by these variables
ORTDIR = /usr/lib/$(DEB_HOST_MULTIARCH)/linux-tts
export SHERPA_ONNXRUNTIME_LIB_DIR = $(ORTDIR)
export SHERPA_ONNXRUNTIME_INCLUDE_DIR = /usr/include/linux-tts/onnxruntime

%:
	dh $@ --buildsystem=cmake

# debhelper sets FETCHCONTENT_FULLY_DISCONNECTED=ON, which skips unpacking
# the local tarballs too; the URLs are local files, nothing is downloaded
override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release \
	  -DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
	  -DBUILD_SHARED_LIBS=ON -DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF \
	  -DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF -DSHERPA_ONNX_ENABLE_PYTHON=OFF \
	  -DSHERPA_ONNX_ENABLE_TESTS=OFF -DSHERPA_ONNX_ENABLE_BINARY=ON \
	  -DSHERPA_ONNX_BUILD_C_API_EXAMPLES=OFF

# cmake installs to /usr: move everything into the private paths beside
# the onnxruntime of libonnxruntime-tts (a distribution sherpa-onnx can sit
# beside it), drop the onnxruntime copies and cmake's .pc, write our own
# .pc, point the RUNPATH to the private directory
PRIV = $(LIBDIR)/linux-tts
override_dh_auto_install:
	dh_auto_install
	cd debian/tmp && rm -f usr/lib/libonnxruntime* usr/sherpa-onnx.pc \
	  && mkdir -p $(PRIV)/pkgconfig $(PRIV)/sherpa-onnx usr/include/linux-tts \
	  && mv usr/lib/libsherpa-onnx-*.so $(PRIV)/ \
	  && mv usr/bin $(PRIV)/sherpa-onnx/bin \
	  && mv usr/include/sherpa-onnx usr/include/linux-tts/
	sed -e 's|@LIBDIR@|$(PRIV)|' -e 's|@VERSION@|$(DEB_VERSION_UPSTREAM)|' \
	  debian/sherpa-onnx.pc.in > debian/tmp/$(PRIV)/pkgconfig/sherpa-onnx.pc
	patchelf --set-rpath $(ORTDIR) debian/tmp/$(PRIV)/sherpa-onnx/bin/* debian/tmp/$(PRIV)/*.so
	mkdir -p debian/tmp/usr/bin
	sed 's|@BINDIR@|/$(PRIV)/sherpa-onnx/bin|' debian/sherpa-say.sh > debian/tmp/usr/bin/sherpa-say
	chmod 755 debian/tmp/usr/bin/sherpa-say

override_dh_shlibdeps:
	dh_shlibdeps -l$(ORTDIR)

# "make check" of sherpa-onnx is clang-tidy, not tests
override_dh_auto_test:
