+++ b/src/ru_normalizr/numerals/_helpers.py
@@ -1413,6 +1413,39 @@ def _rule_numbering_head(ctx: NumeralContext) -> str | None:
     return None
 
 
+def _is_ablt_plur_only(word: str, pos: set[str]) -> bool:
+    parses = [p for p in parse_word(word) if p.tag.POS in pos]
+    return bool(parses) and all(
+        p.tag.case == "ablt" and p.tag.number == "plur" for p in parses
+    )
+
+
+def _rule_instrumental_group(ctx: NumeralContext) -> str | None:
+    """Творительный множественного рядом с числом задаёт ему творительный.
+
+    «допил 2 большими глотками» → «двумя большими глотками», «излучаемое 2
+    телами» → «двумя телами»: форма на -ами/-ями однозначна и сильнее
+    глагола или причастия слева. Без существительного справа то же делает
+    указательное слева: «с этими 2!» → «с этими двумя».
+    """
+    offset = 1
+    while offset <= 3 and ctx.raw(offset).isalpha():
+        word = ctx.word(offset)
+        if _is_ablt_plur_only(word, {"NOUN"}):
+            if ctx.raw(offset)[:1].isupper() and offset == 1:
+                return None
+            return "ablt"
+        if not _is_ablt_plur_only(word, {"ADJF", "PRTF"}):
+            break
+        offset += 1
+    if not ctx.raw(-1).isalpha() or ctx.word(-1) not in {"этими", "теми", "всеми", "обоими"}:
+        return None
+    right = ctx.parse(1) if ctx.raw(1).isalpha() else None
+    if right is not None and right.tag.POS in {"NOUN", "ADJF", "PRTF"}:
+        return None
+    return "ablt"
+
+
 def _rule_label_noun_head(ctx: NumeralContext) -> str | None:
     """Существительное-ярлык слева оставляет число именительным: «рейс 213»."""
     left_noun = ctx.parse(-1)
@@ -1969,6 +2002,7 @@ CASE_RULES: tuple[CaseRule, ...] = (
