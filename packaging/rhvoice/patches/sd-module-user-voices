+      // The languages and voices a user installed without root:
+      // $XDG_DATA_HOME/RHVoice/languages/<name> and voices/<name>, by default
+      // under ~/.local/share. Each one is a resource path of its own, so a
+      // newer version there wins over the one in the data path.
+      void add_user_resources(engine::init_params& p,const std::string& type)
+      {
+        std::string base;
+        const char* xdg=std::getenv("XDG_DATA_HOME");
+        if(xdg&&*xdg=='/')
+          base=xdg;
+        else
+          {
+            const char* home=std::getenv("HOME");
+            if(!home||*home!='/')
+              return;
+            base=path::join(path::join(home,".local"),"share");
+          }
+        const std::string dir=path::join(path::join(base,"RHVoice"),type+"s");
+        if(!path::isdir(dir))
+          return;
+        try
+          {
+            for(path::directory d(dir);!d.done();d.next())
+              if(!d.get().empty()&&d.get()[0]!='.')
+                p.resource_paths.push_back(path::join(dir,d.get()));
+          }
+        catch(const std::exception& e)
+          {
+            logger::log(2,"Cannot read ",dir);
+          }
+      }
+    }
