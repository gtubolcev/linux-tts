+_ONE_BEFORE_THOUSAND = re.compile(r"^(?:одна|одну|одной|одною)\s+(?=тысяч)")
+
+
+def _negated_one(tokens: list[str], idx: int) -> bool:
+    """«Не 1000 лет» — «не одну тысячу лет», то есть много тысяч: «одна» держит смысл."""
+    return idx > 0 and tokens[idx - 1].lower() == "не"
+
+
+def _bare_thousand(clean_token: str, is_negative: bool, words: str) -> str:
+    """Круглая 1000 в речи — «тысяча лет», «около тысячи человек».
+
+    «Одна» остаётся в составных числах («одна тысяча двести») и в денежных
+    суммах; это решают вызывающие, здесь — только сама круглая тысяча.
+    """
+    if clean_token != "1000" or is_negative:
+        return words
+    return _ONE_BEFORE_THOUSAND.sub("", words, count=1)
 
 
