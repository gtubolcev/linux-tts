+#include <dlfcn.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include "core/language.hpp"
+#include "core/voice.hpp"
+#include "text_stages.hpp"
+
+namespace RHVoice
+{
+  namespace sd
+  {
+    namespace
+    {
+      // linux-tts-text.h
+      typedef void* (*new_fn)(const char*);
+      typedef char* (*prepare_fn)(void*,const char*,long,const char*,int,const char*);
+      typedef void (*string_free_fn)(char*);
+
+      void* handle=nullptr;
+      prepare_fn prepare=nullptr;
+      string_free_fn string_free=nullptr;
+
+      // <libdir>/linux-tts/liblinux-tts-text.so.0, <libdir> being where
+      // libc is (/usr/lib/<multiarch>)
+      std::string library_path()
+      {
+        const char* name="liblinux-tts-text.so.0";
+        Dl_info info;
+        if(dladdr(reinterpret_cast<void*>(&std::fopen),&info)&&info.dli_fname!=nullptr)
+          {
+            std::string dir(info.dli_fname);
+            std::string::size_type slash=dir.rfind('/');
+            if(slash!=std::string::npos)
+              return dir.substr(0,slash)+"/linux-tts/"+name;
+          }
+        return name;
+      }
+    }
+
+    void text_stages_init(const char* path)
+    {
+      std::string lib=library_path();
+      void* h=dlopen(lib.c_str(),RTLD_NOW|RTLD_LOCAL);
+      if(h==nullptr)
+        return;                 // not installed: the text stays as it is
+      new_fn create=reinterpret_cast<new_fn>(dlsym(h,"linux_tts_text_new"));
+      prepare_fn p=reinterpret_cast<prepare_fn>(dlsym(h,"linux_tts_text_prepare"));
+      string_free_fn f=reinterpret_cast<string_free_fn>(dlsym(h,"linux_tts_text_string_free"));
+      if(create==nullptr||p==nullptr||f==nullptr)
+        {
+          dlclose(h);
+          return;
+        }
+      handle=create(path);
+      if(handle==nullptr)
+        {
+          dlclose(h);
+          return;
+        }
+      prepare=p;
+      string_free=f;
+    }
+
+    void text_stages_apply(std::string& text,bool ssml,const voice_profile& profile)
+    {
+      if(handle==nullptr||profile.empty()||text.empty())
+        return;
+      const language_info& lang=*(profile.primary()->get_language());
+      // "+" before the stressed vowel only where the language reads it:
+      // languages.Russian.stress_marker=+ in RHVoice.conf; else only ё
+      const char* mark="none";
+      if(lang.supports_stress_marks()&&lang.text_settings.stress_marker.is_set(true)&&
+         static_cast<unsigned int>(lang.text_settings.stress_marker)=='+')
+        mark="+";
+      char* out=prepare(handle,text.data(),static_cast<long>(text.size()),
+                        lang.get_alpha2_code().c_str(),ssml?1:0,mark);
+      if(out==nullptr)
+        return;
+      text.assign(out);
+      string_free(out);
+    }
+  }
+}
