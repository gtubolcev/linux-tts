+std::vector<int64_t> parse_duration_skip(
+    const assets::ResourceBundle & resources,
+    const std::unordered_map<uint32_t, int64_t> & indexer) {
+    const auto root = resources.parse_json("tts_config");
+    std::vector<int64_t> out;
+    const auto * text = root.find("text");
+    if (text == nullptr) {
+        return out;
+    }
+    const auto chars = json::optional_string(*text, "duration_skip", "");
+    for (size_t i = 0; i < chars.size();) {
+        const auto c = static_cast<unsigned char>(chars[i]);
+        const int len = c < 0x80 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : 4;
+        uint32_t cp = len == 1 ? c : c & (0x3F >> (len - 1));
+        for (int k = 1; k < len && i + k < chars.size(); ++k) {
+            cp = (cp << 6) | (static_cast<unsigned char>(chars[i + k]) & 0x3F);
+        }
+        i += len;
+        if (const auto it = indexer.find(cp); it != indexer.end()) {
+            out.push_back(it->second);
+        }
+    }
+    return out;
+}
+
 }  // namespace
 
