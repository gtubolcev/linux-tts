+_NEXT_WORD = re.compile(r"\s+([а-яё]+)\b")
+
+
+def _counted_word_follows(text: str, end: int) -> bool:
+    """Справа счётное слово в родительном множественного: «на 1000 кусочков».
+
+    Год не управляет родительным множественного, а количество — управляет,
+    поэтому «разбилась на 1000 (мелких) кусочков» — не год. Слово со строчной
+    буквы, чтобы «на 1000 Бойцов» не путать. После «в» родительный бывает и
+    у одушевлённого дополнения («в 1812 французов разбили»), поэтому «в»
+    вызывающий исключает.
+    """
+    match = _NEXT_WORD.match(text, end)
+    if match is None:
+        return False
+    parsed = parse_word(match.group(1))
+    if not parsed:
+        return False
+    top = parsed[0].tag
+    return top.POS in {"NOUN", "ADJF"} and top.case == "gent" and top.number == "plur"
+
