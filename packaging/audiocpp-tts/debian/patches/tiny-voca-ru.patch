@@ -0,0 +1,68 @@
+#pragma once
+
+#include "engine/community_models/tiny_voca/assets.h"
+#include "engine/community_models/tiny_voca/runtime.h"
+#include "engine/framework/model_spec/metadata.h"
+#include "engine/framework/runtime/session_base.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace engine::models::tiny_voca_ru {
+
+std::shared_ptr<runtime::IVoiceModelLoader> make_tiny_voca_ru_loader();
+
+// Turns a request away, with runtime::InvalidRequestError, when it names a
+// language other than Russian (ru, ru-ru, Russian, in any case). No language
+// is Russian.
+void require_russian(const runtime::TaskRequest & request);
+
+// The sentences of a text, without a break after an abbreviation (тыс., ул.)
+// or an initial (tokenize.split_sentences).
+std::vector<std::string> sentences(const std::string & text);
+// The text with a full stop added when it ends without a mark
+// (tokenize.ensure_terminal_punctuation).
+std::string finished(const std::string & text);
+// The text in smaller pieces: cut after commas and the like if it has any,
+// else in two between words. Empty for a single word (tokenize.split_clause).
+std::vector<std::string> shorter(const std::string & text);
+
+// tiny-voca-ru: the tiny-voca architecture trained on Russian, with its own
+// phoneme set and a rule-based frontend. The text has to carry its stress
+// ("+" before the stressed vowel, or U+0301 after it) and be normalised
+// already: digits and Latin letters are not read.
+class TinyVocaRuSession final
+    : public runtime::RuntimeSessionBase
+    , public runtime::IOfflineVoiceTaskSession {
+public:
+    TinyVocaRuSession(
+        runtime::TaskSpec task,
+        runtime::SessionOptions options,
+        std::shared_ptr<const tiny_voca::TinyVocaAssets> assets,
+        std::shared_ptr<const engine::model_spec::ModelContract> contract);
+    ~TinyVocaRuSession() override;
+
+    std::string family() const override;
+    runtime::VoiceTaskKind task_kind() const override;
+    runtime::RunMode run_mode() const override;
+    void prepare(const runtime::SessionPreparationRequest & request) override;
+    runtime::TaskResult run(const runtime::TaskRequest & request) override;
+
+private:
+    tiny_voca::TinyVocaGenerationOptions generation_options(const runtime::TaskRequest & request) const;
+    // Speaks one piece of text, cutting it smaller when it is too long for one pass.
+    void speak(
+        const std::string & text,
+        const tiny_voca::TinyVocaGenerationOptions & options,
+        std::vector<std::vector<float>> & waves,
+        int64_t & spoken);
+
+    runtime::TaskSpec task_;
+    std::shared_ptr<const tiny_voca::TinyVocaAssets> assets_;
+    std::shared_ptr<const engine::model_spec::ModelContract> contract_;
+    std::unique_ptr<tiny_voca::TinyVocaRuntime> runtime_;
+    std::vector<int32_t> id_of_symbol_;     // frontend symbol id -> model vocabulary id
+};
+
+}  // namespace engine::models::tiny_voca_ru
