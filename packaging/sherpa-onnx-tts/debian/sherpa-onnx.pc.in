prefix=/usr
includedir=${prefix}/include/linux-tts
libdir=/@LIBDIR@

Name: sherpa-onnx
Description: Speech recognition and synthesis with ONNX Runtime (linux-tts private build)
URL: https://github.com/k2-fsa/sherpa-onnx
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -Wl,-rpath,${libdir} -lsherpa-onnx-c-api
Libs.private: -lonnxruntime
