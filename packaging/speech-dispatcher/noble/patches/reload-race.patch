diff --git a/src/server/speechd.c b/src/server/speechd.c
index 92b7b18..9c3bdee 100644
--- a/src/server/speechd.c
+++ b/src/server/speechd.c
@@ -561,8 +561,11 @@ void speechd_module_nodebug(gpointer data, gpointer user_data)
 
 static gboolean speechd_reload_dead_modules(gpointer user_data)
 {
-	/* Reload dead modules */
+	/* Reload dead modules.  The speak thread looks modules up in the
+	 * list while it holds element_free_mutex. */
+	pthread_mutex_lock(&element_free_mutex);
 	g_list_foreach(output_modules, speechd_modules_reload, NULL);
+	pthread_mutex_unlock(&element_free_mutex);
 
 	/* Make sure there aren't any more child processes left */
 	while (waitpid(-1, NULL, WNOHANG) > 0) ;
@@ -831,6 +834,20 @@ static gboolean speechd_load_configuration(gpointer user_data)
 	return TRUE;
 }
 
+static gboolean speechd_reload_configuration(gpointer user_data)
+{
+	gboolean ret;
+
+	/* The speak thread looks the output module of a message up in
+	 * output_modules while it holds element_free_mutex.  Hold it while the
+	 * modules are freed and loaded again, so that it neither walks a list
+	 * being freed nor finds it empty and drops the message. */
+	pthread_mutex_lock(&element_free_mutex);
+	ret = speechd_load_configuration(user_data);
+	pthread_mutex_unlock(&element_free_mutex);
+	return ret;
+}
+
 static gboolean speechd_quit(gpointer user_data)
 {
 	switch ((enum quit_reason)(uintptr_t) user_data) {
@@ -1357,7 +1374,7 @@ int main(int argc, char *argv[])
         main_loop = g_main_loop_new(g_main_context_default(), FALSE);
 	g_unix_signal_add(SIGINT, speechd_quit, (void*) (uintptr_t) QUIT_SIGINT);
 	g_unix_signal_add(SIGTERM, speechd_quit, (void*) (uintptr_t) QUIT_SIGTERM);
-	g_unix_signal_add(SIGHUP, speechd_load_configuration, NULL);
+	g_unix_signal_add(SIGHUP, speechd_reload_configuration, NULL);
 	g_unix_signal_add(SIGUSR1, speechd_reload_dead_modules, NULL);
 	(void)signal(SIGPIPE, SIG_IGN);
 
