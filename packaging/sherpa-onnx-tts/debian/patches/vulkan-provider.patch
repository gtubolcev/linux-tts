+          "Vulkan needs ONNX Runtime 1.23 or newer. Current API version: %d. "
+          "Fallback to cpu!",
+          static_cast<int32_t>(ORT_API_VERSION));
+#endif
+      break;
     }
   }
   return sess_opts;
