+#!/usr/bin/env python3
+"""Pack tiny-voca-ru as one GGUF file for audio.cpp.
+
+    python tools/community_models/convert_tiny_voca_ru.py \
+        --source /path/to/tiny-voca-ru --output models/tiny-voca-ru-GGUF/tiny-voca-ru-orig.gguf
+
+``--source`` is a copy of https://huggingface.co/egnch/tiny-voca-ru: it needs
+``config.json`` and ``model.safetensors``. The weights are stored as float32,
+bit for bit. The config is rewritten in the layout of the English tiny-voca
+(``model``, ``vocab``) with the lists of phonemes and vowels that the runtime
+reads. ``--check`` reads the GGUF back and compares.
+
+Needs numpy and safetensors, and a built ``audiocpp_gguf``.
+"""
+
+import argparse
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+import numpy as np
+from safetensors.numpy import load_file, save_file
+
+REPO = Path(__file__).resolve().parents[2]
+# tiny_voca_ru.frontend.symbols: 5 special tokens, 12 punctuation marks, the consonants, then these vowels.
+VOWELS = ["a", "o", "e", "i", "u", "ɨ", "ɐ", "ə"]
+SPECIALS = ["<pad>", "<bos>", "<eos>", "<sp>", "<unk>"]
+PUNCTUATION_COUNT = 12
+
+
+def model_config(source):
+    data = json.loads((source / "config.json").read_text(encoding="utf-8"))
+    if data.get("format_version") != 1:
+        raise ValueError(f"unknown tiny-voca-ru config format {data.get('format_version')}")
+    symbols, model = data["symbols"], data["config"]
+    if symbols[:5] != SPECIALS or symbols[-len(VOWELS):] != VOWELS or len(symbols) != model["vocab_size"]:
+        raise ValueError("the phoneme inventory is not the one of tiny-voca-ru 0.2")
+    phones = symbols[len(SPECIALS) + PUNCTUATION_COUNT:] + ["<unk>"]   # <unk> stands for a phoneme, too
+    return {
+        "model": model,
+        "vocab": {symbol: index for index, symbol in enumerate(symbols)},
+        "phones": phones,
+        "vowels": VOWELS,
+        "frontend": "ru",
+        "step": data.get("step"),
+    }
+
+
+def model_tensors(source):
+    tensors = load_file(str(source / "model.safetensors"))
+    for name, array in tensors.items():
+        if array.dtype != np.float32:
+            raise ValueError(f"{name} is {array.dtype}; a float32 checkpoint is expected")
+    return {name: np.ascontiguousarray(array) for name, array in tensors.items()}
+
+
+def write_model_directory(source, root):
+    """The files audio.cpp reads, in a folder: it can be loaded as it is, too."""
+    root.mkdir(parents=True, exist_ok=True)
+    (root / "config.json").write_text(json.dumps(model_config(source), ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    tensors = model_tensors(source)
+    save_file(tensors, str(root / "model.safetensors"))
+    return tensors
+
+
+def check(path, tensors):
+    """Every tensor in the GGUF equals the source, byte for byte."""
+    import gguf
+    reader = gguf.GGUFReader(str(path))
+    stored = {tensor.name: tensor for tensor in reader.tensors}
+    wrong = 0
+    for name, array in tensors.items():
+        found = next((stored[key] for key in (f"model/{name}", f"model.{name}", name) if key in stored), None)
+        if found is None or np.asarray(found.data).tobytes() != array.tobytes():
+            wrong += 1
+            print("DIFFERENT" if found is not None else "MISSING", name)
+    print(f"{len(tensors)} tensors checked, {wrong} wrong; {len(stored)} tensors in the file")
+    return wrong == 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", type=Path, required=True, help="A copy of the Hugging Face repository egnch/tiny-voca-ru")
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--converter", type=Path, default=REPO / "build/bin/audiocpp_gguf")
+    parser.add_argument("--directory", type=Path, help="Also keep the unpacked model folder here (loadable as it is)")
+    parser.add_argument("--check", action="store_true", help="Read the GGUF back and compare every tensor (needs the gguf package)")
+    parser.add_argument("--overwrite", action="store_true")
+    args = parser.parse_args()
+    if args.output.exists() and not args.overwrite:
+        raise FileExistsError(args.output)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix=".tiny-voca-ru-", dir=args.output.parent) as temporary:
+        root = args.directory or Path(temporary) / "tiny-voca-ru"
+        tensors = write_model_directory(args.source, root)
+        command = [str(args.converter.resolve()), "--input", f"model={root / 'model.safetensors'}", "--root", str(root),
+                   "--family", "tiny_voca_ru", "--model-spec", str(REPO / "model_specs/tiny_voca_ru.json"), "--type", "orig",
+                   "--output", str(args.output.resolve())]
+        if args.overwrite:
+            command.append("--overwrite")
+        subprocess.run(command, check=True)
+    print(f"wrote {args.output} ({args.output.stat().st_size / 1e6:.1f} MB): {len(tensors)} tensors, "
+          f"{sum(v.size for v in tensors.values()):,} parameters")
+    if args.check and not check(args.output, tensors):
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
