#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# vosk, kokoro and teratts are built against the private onnxruntime of
# libonnxruntime-tts (the one sherpa-onnx and the Vulkan plugin EP use),
# not the distribution's: its .pc, and a RUNPATH to find it at run time
ORTDIR = /usr/lib/$(DEB_HOST_MULTIARCH)/linux-tts
export PKG_CONFIG_PATH = $(ORTDIR)/pkgconfig
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-rpath,$(ORTDIR)

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dvosk=enabled -Dkokoro=enabled -Dteratts=enabled \
	  -Dsilero=enabled -Dsherpa=enabled

override_dh_shlibdeps:
	dh_shlibdeps -l$(ORTDIR)
