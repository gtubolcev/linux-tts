+def _rule_noun_head_genitive(ctx: NumeralContext) -> str | None:
+    """Количественная группа как определение вершины слева — в родительном.
+
+    «Мнение 10 экспертов» → «мнение десяти экспертов», «результат 10 лет
+    работы», «Ценность этих 7 лет». Вершина — неодушевлённое нарицательное в
+    именительном без предлога перед ним, справа — известное существительное в
+    родительном множественного. Значения («рост 180 см», «сумма 500 рублей»),
+    ярлыки и срок при сказуемом («Завод 5 лет выпускал», «5 лет назад») не
+    трогаются.
+    """
+    parsed_number = parse_integer_token(ctx.token)
+    if parsed_number is None or noun_number_form(int(parsed_number[1])) == "one":
+        return None
+    head_offset = -1
+    if ctx.raw(-1).isalpha():
+        left = ctx.parse(-1)
+        if left is not None and left.tag.POS in {"ADJF", "PRTF"}:
+            if left.tag.case != "gent" or left.tag.number != "plur":
+                return None
+            head_offset = -2
+    else:
+        return None
+    if not ctx.raw(head_offset).isalpha():
+        return None
+    head = ctx.parse(head_offset)
+    if head is None or head.tag.POS != "NOUN" or head.tag.case != "nomn":
+        return None
+    if not is_case_reliable_noun(head) or "anim" in head.tag:
+        return None
+    if {"Name", "Surn", "Patr", "Geox", "Orgn", "Abbr"} & head.tag.grammemes:
+        return None
+    lemma = head.normal_form
+    if (
+        lemma in _VALUE_HEAD_LEMMAS
+        or lemma in MEASURE_PARAMETER_HEADS
+        or lemma in LABEL_NOUN_LEMMAS
+        or lemma in _TIME_CONTEXT_LEMMAS
+        or lemma in _TIME_COUNTED_LEMMAS
+    ):
+        return None
+    before = ctx.parse(head_offset - 1)
+    if before is not None and before.tag.POS in {"PREP", "VERB", "INFN"}:
+        return None
+    right = ctx.word(1)
+    if not right or not ctx.raw(1).isalpha() or not word_is_known(right):
+        return None
+    if ctx.raw(1)[:1].isupper():
+        return None
+    # Единица измерения делает число значением: «нагрузка 2500 килограмм».
+    if is_unit_token(ctx.raw(1)) and ctx.word(1) not in TIME_WORDS:
+        return None
+    top = ctx.parse(1)
+    if (
+        top is None
+        or top.normal_form == "раз"
+        or top.tag.POS not in {"NOUN", "ADJF"}
+        or top.tag.case != "gent"
+        or top.tag.number != "plur"
+    ):
+        return None
+    after = ctx.parse(2)
+    if ctx.word(2) in _GROUP_END_MARKERS:
+        return None
+    if top.normal_form in _TIME_COUNTED_LEMMAS:
+        # Срок сам по себе чаще сказуемое или обстоятельство («Дорога 5
+        # часов», «Завод 10 лет выпускал»); определением его делает
+        # согласованное слово слева или родительный справа («10 лет работы»).
+        if head_offset == -1 and (
+            after is None or after.tag.POS != "NOUN" or after.tag.case != "gent"
+        ):
+            return None
+    elif after is not None and (
+        after.tag.POS == "INFN" or (after.tag.POS == "VERB" and "tran" in after.tag)
+    ):
+        # Переходный глагол сразу за группой делает её прямым дополнением при
+        # подлежащем слева: «Кошка 5 котят родила».
+        return None
+    return "gent"
+
