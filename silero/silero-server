#!/usr/bin/python3 -I
"""silero-server: a small HTTP server on a Unix socket for sd_silero.

It keeps a Silero TTS model (ONNX, run by the silero-tts-onnx runtime)
loaded, so speech-dispatcher does not load it for every message.

  GET  /v2/health    200 once the model is loaded
  GET  /v2/voices    {"version": ..., "speakers": [...]}
  POST /v2/generate  {"text": str, "speaker": str,
                      "rate": float (1 = normal), "pitch": float (1 = normal)}
                     -> float32 mono PCM, X-Audio-Sample-Rate header

The socket (--socket) is created for the user only; sd_silero puts it in
$XDG_RUNTIME_DIR. No TCP port: web pages and other users cannot reach it.

The model and the runtime are not part of this program; they are
installed with their licences into a directory given by --dir:

  <dir>/silero_onnx/   the runtime (python package)
  <dir>/models/        the ONNX files of the model version

The runtime is code from the internet, so it is imported only if its files
are the ones listed in --manifest (sha256 of a known release).

Copyright (C) 2026 Grigory Tuboltsev
SPDX-License-Identifier: GPL-3.0-or-later
"""
import argparse
import hashlib
import importlib.util
import json
import os
import signal
import socketserver
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler
from xml.sax.saxutils import escape

engine = None
engine_lock = threading.Lock()
SAMPLE_RATE = 48000
# the onnxruntime of python3-onnxruntime-tts (the release the other modules
# use), off Python's search path; the distribution's one otherwise
ORT_DIR = "/usr/lib/python3/linux-tts"
MANIFEST = "/usr/share/speech-dispatcher-silero/silero_onnx.sha256"


def log(*a):
    print("silero-server:", *a, file=sys.stderr, flush=True)


def check_runtime(pkg, manifest):
    """Raises unless pkg holds exactly the files of the manifest."""
    want = {}
    with open(manifest, encoding="utf-8") as f:
        for line in f:
            if line.strip() and not line.startswith("#"):
                digest, name = line.rstrip("\n").split("  ", 1)
                want[name] = digest
    have = set()
    if os.path.islink(pkg):
        raise RuntimeError(f"{pkg} is a symbolic link")
    for root, dirs, files in os.walk(pkg):
        # bytecode is never read from there (pycache_prefix in load)
        dirs[:] = [d for d in dirs if d != "__pycache__"
                   or os.path.islink(os.path.join(root, d))]
        for name in dirs + files:
            path = os.path.join(root, name)
            if os.path.islink(path):
                raise RuntimeError(f"{path} is a symbolic link")
            if name in files:
                have.add(os.path.relpath(path, pkg))
    # any other file could be imported: an extension module (.so) wins
    # over the .py of the same name, a sourceless .pyc is imported too
    bad = sorted(have - want.keys())
    if bad:
        raise RuntimeError(f"unknown files in {pkg}: {' '.join(bad)}")
    for name, digest in want.items():
        with open(os.path.join(pkg, name), "rb") as f:
            if hashlib.sha256(f.read()).hexdigest() != digest:
                raise RuntimeError(f"{pkg}/{name} is not the file of the known release "
                                   f"(see {manifest})")


def load(args):
    global engine
    pkg = os.path.join(args.dir, "silero_onnx")
    if args.manifest:
        check_runtime(pkg, args.manifest)
    # compile the checked sources; never use .pyc files lying next to them
    sys.dont_write_bytecode = True
    sys.pycache_prefix = "/nonexistent/silero-server"
    if os.path.isdir(os.path.join(ORT_DIR, "onnxruntime")):
        sys.path.insert(0, ORT_DIR)
    # the libraries before the package, and the model directory never on
    # sys.path: a numpy.py or onnxruntime/ there would be imported instead
    import numpy  # noqa: F401  (fail early with a clear message)
    import onnxruntime
    log(f"onnxruntime {onnxruntime.__version__} from {os.path.dirname(onnxruntime.__file__)}")
    spec = importlib.util.spec_from_file_location(
        "silero_onnx", os.path.join(pkg, "__init__.py"), submodule_search_locations=[pkg])
    sys.modules["silero_onnx"] = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(sys.modules["silero_onnx"])
    from silero_onnx import ort as silero_ort
    from silero_onnx.engine import SileroTTS

    base_options = silero_ort.session_options

    def session_options():
        so = base_options()
        so.intra_op_num_threads = args.threads
        return so

    # create_session looks the function up at call time
    silero_ort.session_options = session_options
    t = time.monotonic()
    tts = SileroTTS(model_dir=os.path.join(args.dir, "models"), version=args.version)
    # the first call builds caches; do it now, not with the first message
    tts.synthesize("Готово.", speaker=tts.speakers[0])
    engine = tts
    log(f"{args.version} loaded in {time.monotonic() - t:.1f} s, "
        f"{args.threads} thread(s), speakers: {' '.join(tts.speakers)}")


def to_ssml(text, rate, pitch):
    # "*word*" means emphasis to the runtime, "+" before a vowel stress;
    # keep "+" (users may write stress marks), drop the asterisks
    text = escape(text.replace("*", " "))
    attrs = ""
    if abs(rate - 1.0) > 0.01:
        attrs += f' rate="{round(rate * 100)}%"'
    if abs(pitch - 1.0) > 0.01:
        p = round((pitch - 1.0) * 100)
        attrs += f' pitch="{"+" if p >= 0 else "-"}{abs(p)}%"'
    if attrs:
        text = f"<prosody{attrs}>{text}</prosody>"
    return f"<speak>{text}</speak>"


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def address_string(self):
        return "local"

    def log_message(self, fmt, *a):
        if self.server.verbose:
            log(fmt % a)

    def reply(self, status, body, ctype="application/json", headers=()):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass   # the module stopped listening (speech stopped)
        self.close_connection = True

    def error(self, status, msg):
        self.reply(status, json.dumps({"error": msg}).encode())

    def do_GET(self):
        if engine is None:
            return self.error(503, "loading")
        if self.path == "/v2/health":
            return self.reply(200, b'{"status": "ok"}')
        if self.path == "/v2/voices":
            return self.reply(200, json.dumps({"version": self.server.version,
                                               "speakers": engine.speakers}).encode())
        self.error(404, "not found")

    def do_POST(self):
        if self.path != "/v2/generate":
            return self.error(404, "not found")
        if engine is None:
            return self.error(503, "loading")
        try:
            n = int(self.headers.get("Content-Length", "0"))
            if not 0 < n <= 1 << 20:
                return self.error(400, "bad length")
            req = json.loads(self.rfile.read(n))
            text = str(req.get("text", "")).strip()
            speaker = str(req.get("speaker", engine.speakers[0]))
            rate = min(max(float(req.get("rate", 1.0)), 0.5), 2.0)
            pitch = min(max(float(req.get("pitch", 1.0)), 0.75), 1.25)
        except (ValueError, TypeError, AttributeError) as e:
            return self.error(400, f"bad request: {e}")
        if speaker not in engine.speakers:
            return self.error(400, f"unknown speaker {speaker}")
        audio = b""
        if text:
            try:
                with engine_lock:
                    if abs(rate - 1.0) > 0.01 or abs(pitch - 1.0) > 0.01:
                        out, _dur = engine.synthesize(to_ssml(text, rate, pitch),
                                                      speaker=speaker, ssml=True)
                    else:   # plain text: the frontend handles + and * marks itself
                        out, _dur = engine.synthesize(text, speaker=speaker)
                audio = out.astype("<f4").tobytes()
            except Exception as e:   # noqa: BLE001  (a bad sentence must not kill the server)
                log(f"cannot synthesize {text!r}: {type(e).__name__}: {e}")
                return self.error(500, f"{type(e).__name__}: {e}")
        self.reply(200, audio, "application/octet-stream",
                   [("X-Audio-Sample-Rate", str(SAMPLE_RATE))])


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--dir", required=True, help="runtime + models directory")
    ap.add_argument("--version", default="v5_6_ru")
    ap.add_argument("--socket", required=True, help="path of the Unix socket to create")
    ap.add_argument("--manifest", default=MANIFEST,
                    help="sha256 list of the runtime files; empty = do not check")
    ap.add_argument("--threads", type=int, default=2)
    ap.add_argument("--verbose", action="store_true")
    args = ap.parse_args()

    # the socket is the user's only: no group or other access from the start
    os.umask(0o077)
    try:
        os.unlink(args.socket)
    except FileNotFoundError:
        pass
    httpd = socketserver.UnixStreamServer(args.socket, Handler)

    def stop(_sig, _frame, code=0):
        try:
            os.unlink(args.socket)
        except OSError:
            pass
        os._exit(code)

    signal.signal(signal.SIGTERM, stop)
    httpd.verbose = args.verbose
    httpd.version = args.version
    # answer /v2/health with 503 while the model loads
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    try:
        load(args)
    except BaseException as e:   # noqa: BLE001
        log(f"cannot load the model from {args.dir}: {type(e).__name__}: {e}")
        stop(None, None, 1)
    try:
        threading.Event().wait()
    except KeyboardInterrupt:
        stop(None, None)


if __name__ == "__main__":
    main()
